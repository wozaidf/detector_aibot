# Fill in the API key and model names for your deployment.
JEV_API_KEY=
JEV_NAME=
LAYA_MODEL_NAME=

KAFKA_BOOTSTRAP_SERVERS=kafka:29092
L4_CONSUMER_TOPIC=l25-iforest-events
L4_PRODUCER_TOPIC=l4-anomaly-decisions
L4_GROUP_ID=l4-group-1
L4_AUTO_OFFSET_RESET=earliest
L4_DIAGNOSIS_THRESHOLD=0.8

# Set the credentials to match your PostgreSQL instance.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=anomaly_db
POSTGRES_USER=
POSTGRES_PASSWORD=
