# Drools 普通单指标标记阈值：CPU 均值，单位百分比。
L2_CPU_HIGH_PCT=90.0
# Drools 普通单指标标记阈值：内存均值，单位百分比。
L2_MEMORY_HIGH_PCT=90.0
# Drools 普通单指标标记阈值：延迟均值，单位毫秒。
L2_LATENCY_HIGH_MS=200.0
# Drools 普通单指标标记阈值：丢包率，范围 0–1。
L2_PACKET_LOSS_HIGH_RATIO=0.03
# Drools 普通单指标标记阈值：日志错误率，范围 0–1。
L2_LOG_ERROR_RATE=0.3
# Drools 普通单指标标记阈值：Span 失败率，范围 0–1。
L2_SPAN_FAILURE_RATE=0.3
# Drools 严重单指标候选阈值：CPU 均值，单位百分比。
L2_CPU_SEVERE_PCT=95.0
# Drools 严重单指标候选阈值：内存均值，单位百分比。
L2_MEMORY_SEVERE_PCT=92.0
# Drools 严重单指标候选阈值：延迟均值，单位毫秒。
L2_LATENCY_SEVERE_MS=220.0
# Drools 严重单指标候选阈值：丢包率，范围 0–1。
L2_PACKET_LOSS_SEVERE_RATIO=0.05
# Drools 严重单指标候选阈值：日志错误率，范围 0–1。
L2_LOG_ERROR_SEVERE_RATE=0.6
# Drools 严重单指标候选阈值：Span 失败率，范围 0–1。
L2_SPAN_FAILURE_SEVERE_RATE=0.8
# Drools 网络联合候选阈值：延迟均值，单位毫秒；需与联合丢包率同时满足。
L2_JOINT_NETWORK_LATENCY_MS=200.0
# Drools 网络联合候选阈值：丢包率，范围 0–1；需与联合延迟同时满足。
L2_JOINT_NETWORK_PACKET_LOSS_RATIO=0.03
# Drools 日志-Trace 联合候选阈值：日志错误率，范围 0–1。
L2_JOINT_LOG_ERROR_RATE=0.3
# Drools 日志-Trace 联合候选阈值：Span 失败率，范围 0–1。
L2_JOINT_SPAN_FAILURE_RATE=0.3
# Drools 日志-Trace 联合候选阈值：至少需要关联的错误日志与失败 Span 数。
L2_JOINT_LOG_TRACE_MIN_OVERLAP_COUNT=1
# Drools 多信号联合候选阈值：CPU 均值，单位百分比。
L2_JOINT_MULTI_CPU_PCT=90.0
# Drools 多信号联合候选阈值：最少失败 Span 数。
L2_JOINT_MULTI_MIN_FAILED_SPAN_COUNT=1
# Drools 多信号联合候选阈值：最少告警数。
L2_JOINT_MULTI_MIN_ALARM_COUNT=1
# Drools 单窗口重复错误标记阈值：错误日志数。
L2_REPEATED_ERROR_COUNT=3
# CEP 连续异常候选阈值：同一实体连续命中的最少窗口数。
L2_CEP_OCCURRENCES=3
# CEP CPU/Span 后接告警的两窗口关联最大事件时间跨度，单位秒。
L2_CEP_COMPLEX_HORIZON_SECONDS=600
# Flink 水印乱序容忍和候选融合迟到余量，单位秒。
L2_WATERMARK_SECONDS=5
# Flink 输入分区空闲超时，单位秒。
L2_IDLE_SECONDS=30
# L1 窗口重放去重状态保留时间，单位秒。
L2_DEDUP_SECONDS=300
# 候选事件缺少窗口 ID 时允许回退使用的时间关联范围，单位秒。
L2_ASSOCIATION_WINDOW_SECONDS=300
# CEP 连续序列的最长时长，超时后封口并释放状态，单位秒。
L2_CEP_MAX_SEQUENCE_SECONDS=604800
