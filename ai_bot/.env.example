# 复制为 .env 后，按所用服务填写模型、API 密钥和连接信息。

# 主 Agent（OpenAI 兼容接口）
MODEL_NAME=your_model_name
MODEL_TEMPERATURE=0.2
MODEL_API_KEY=
MODEL_MAX_TOKENS=4096
# 使用兼容网关时填写其 API 基础地址，例如 https://gateway.example.com/v1。
MODEL_BASE_URL=

# GraphRAG（DashScope）
NEO4J_GRAPHRAG_MODEL=kimi-k3.1-pro
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# Neo4j（以下为本地连接示例）
NEO4J_PASSWORD=
NEO4J_URI=neo4j://127.0.0.1:7687
NEO4J_USERNAME=neo4j
